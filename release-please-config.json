{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "python",
  "include-component-in-tag": false,
  "packages": {
    ".": {
      "package-name": "gafour",
      "extra-files": [
        {
          "type": "json",
          "path": "skills/gafour-cli/compatibility.json",
          "jsonpath": "$.cli_version"
        },
        {
          "type": "toml",
          "path": "uv.lock",
          "jsonpath": "$.package[?(@.name.value == 'gafour')].version"
        },
        {
          "type": "generic",
          "path": "README.md"
        }
      ]
    }
  }
}
